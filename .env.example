# Database Configurations
DATABASE_URL=
BANKING_DATABASE_URL=

# Application Secrets
# Must be generated using a strong CSPRNG, e.g. `openssl rand -hex 32`
API_KEY=
JWT_SECRET=

# Redis / Celery (Optional)
USE_CELERY=false
REDIS_URL=

# Third Party AI APIs
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Security & CORS
CORS_ALLOW_ORIGINS=
ALLOW_INSECURE_CORS=false
CERT_STRICTNESS_PERCENT=40

# Tuning Parameters
SCAN_DISCOVERY_TIMEOUT_SEC=45.0
SCAN_DISCOVERY_TIMEOUT_SEC_DEEP=120.0
SCAN_CONCURRENCY=50
REUSE_COMPLETED_SCANS=false
